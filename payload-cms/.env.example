# Required in the existing Vercel project: managed Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required: generate a long random secret, at least 32 characters.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Same public project and domain: website at /, Payload login at /admin.
PAYLOAD_PUBLIC_SERVER_URL=https://digitale-gewinner.de
PUBLIC_WEBSITE_URL=https://digitale-gewinner.de

# Use true for the first database initialization, then change to false.
PAYLOAD_DB_PUSH=true

# Required for the /api/chat website chatbot: an Experiential Labs API key
# (https://platform.experientiallabs.ai), format xpl_... . Never commit the
# real value - set it in the Vercel project's environment variables.
EXPERIENTIAL_API_KEY=xpl_replace-with-your-real-key

# Optional: model slug to use for the chatbot (see platform.experientiallabs.ai/docs/models).
# Defaults to gpt-5.5 if unset.
EXPERIENTIAL_MODEL=gpt-5.5

# Required for the daily blog generator (/api/generate-blog-post, triggered by
# Vercel Cron per vercel.json). Vercel automatically sends this value as
# "Authorization: Bearer <CRON_SECRET>" on cron-triggered requests, so setting
# this env var is enough - no extra wiring needed. Generate any long random string.
CRON_SECRET=replace-with-a-long-random-secret
